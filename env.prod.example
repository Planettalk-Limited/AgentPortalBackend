# Production Environment Variables
# Copy this file to .env.prod and fill in your production values

# Database Configuration
DB_PASSWORD=your-strong-database-password-here
REDIS_PASSWORD=your-strong-redis-password-here

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-for-production-min-32-chars

# Email Service (Mailgun)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain

# Additional Mailgun Configuration
# Note: MAILGUN_FROM_EMAIL is the display "From" address that recipients will see
# The actual SMTP sender (marketing@planettalk.com) is configured in Mailgun
MAILGUN_FROM_EMAIL=partners@planettalk.com
MAILGUN_FROM_NAME=PlanetTalk Partners
MAILGUN_API_URL=https://api.eu.mailgun.net

# Partner lifecycle emails (src/modules/lifecycle-emails). OFF until explicitly enabled.
LIFECYCLE_EMAILS_ENABLED=false
# Daily run (cron syntax) and its time zone
LIFECYCLE_EMAILS_CRON=0 9 * * *
LIFECYCLE_EMAILS_TIMEZONE=Europe/London
# Lifetime commission thresholds (USD) for "You've earned $X" emails
LIFECYCLE_EARNINGS_THRESHOLDS=50,100,250
LIFECYCLE_REFERRAL_MILESTONES=1,5,10,25,50,100
# Who is told about a partner's 100th referral (defaults to ADMIN_BUSINESS_APPLICATION_EMAILS)
LIFECYCLE_PARTNER_TEAM_EMAILS=partners@planettalk.com
# Templates are placeholder copy (draft) until the client signs off; drafts are only sent when true
LIFECYCLE_ALLOW_DRAFT_COPY=false
# Optional: only email these addresses / @domains (staging and client review)
LIFECYCLE_RECIPIENT_ALLOWLIST=
# Public base URL of this API, used in unsubscribe links
LIFECYCLE_PUBLIC_API_URL=https://api.planettalk.com/api/v1
# Signs unsubscribe links (falls back to JWT_SECRET)
LIFECYCLE_UNSUBSCRIBE_SECRET=
# Mailgun > Sending > Webhooks > "HTTP webhook signing key"; webhook URL: <LIFECYCLE_PUBLIC_API_URL>/lifecycle-emails/webhooks/mailgun
MAILGUN_WEBHOOK_SIGNING_KEY=
# Tuning (defaults shown)
LIFECYCLE_MAX_EMAILS_PER_PARTNER_PER_DAY=1
LIFECYCLE_CATCH_UP_DAYS=3
LIFECYCLE_ATTRIBUTION_DAYS=30
LIFECYCLE_ACTIVE_MONTHLY_FROM_DAY=15
LIFECYCLE_MAX_SEND_ATTEMPTS=3

# Frontend URL for email links
FRONTEND_URL=https://portal.planettalk.com

# Digital Ocean Spaces (S3-compatible) Configuration
DO_SPACES_ACCESS_KEY=your-do-spaces-access-key
DO_SPACES_SECRET_KEY=your-do-spaces-secret-key
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=your-bucket-name

# Note: Use the region endpoint (e.g., nyc3, lon1, fra1, sgp1, sfo3)
# Common endpoints:
# - NYC3: https://nyc3.digitaloceanspaces.com
# - LON1: https://lon1.digitaloceanspaces.com  
# - FRA1: https://fra1.digitaloceanspaces.com
# - SGP1: https://sgp1.digitaloceanspaces.com
# - SFO3: https://sfo3.digitaloceanspaces.com

# Optional: Additional production settings
# SENTRY_DSN=your-sentry-dsn-for-error-tracking
# NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
